config {
  type: "view",
  schema: "rpc_estimator",
  description: "Training frame consumed by services/ml-pipeline BigQueryFeatureRepo. Shape matches msm_ml.domain.FeatureVector. Schema: PRD V2 (Credit Cards) §7.1.",
  assertions: {
    nonNull: ["click_id", "vertical_id", "product_type", "target_revenue"],
  },
}

SELECT
  cr.click_id,
  cr.click_ts_ms,
  cr.vertical_id,
  cr.device,
  cr.geo,
  cr.hour_of_day,
  cr.product_type,
  cr.card_product_id,
  cr.query_intent,
  cr.affinity_score,
  cr.prior_applicant,
  cr.income_band_bucket,
  COALESCE(rr.rpc_14d, 0.0) AS rpc_14d,
  COALESCE(rr.rpc_60d, 0.0) AS rpc_60d,
  COALESCE(a.auction_pressure, 0.5) AS auction_pressure,
  cr.visits_prev_30d,
  cr.target_revenue
FROM ${ref("click_revenue")} cr
LEFT JOIN ${ref("rolling_rpc")} rr USING (click_id)
LEFT JOIN ${ref("sa360_auctions")} a ON a.click_id = cr.click_id
