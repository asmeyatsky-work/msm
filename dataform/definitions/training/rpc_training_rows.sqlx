config {
  type: "view",
  schema: "rpc_estimator",
  description: "Training frame consumed by services/ml-pipeline BigQueryFeatureRepo. Shape matches msm_ml.domain.FeatureVector. Schema: PRD V2 (Credit Cards) §7.1.",
  assertions: {
    nonNull: ["click_id", "vertical_id", "product_type", "target_revenue"],
  },
}

SELECT
  cr.click_id,
  cr.click_ts_ms,
  cr.vertical_id,
  cr.device,
  cr.geo,
  cr.hour_of_day,
  cr.product_type,
  cr.card_product_id,
  cr.query_intent,
  cr.affinity_score,
  cr.prior_applicant,
  cr.income_band_bucket,
  COALESCE(rr.rpc_14d, 0.0) AS rpc_14d,
  COALESCE(rr.rpc_60d, 0.0) AS rpc_60d,
  COALESCE(a.auction_pressure, 0.5) AS auction_pressure,
  cr.visits_prev_30d,
  -- Phoebe features. Joined on user_pseudo_id when the click stream carries
  -- it (preferred); falls back to defaults until the click contract is
  -- extended. OQ-12 (event taxonomy) is the gating client decision; the
  -- click→cookie join key is OQ-13 (open).
  COALESCE(ph.phoebe_calculator_used, FALSE) AS phoebe_calculator_used,
  COALESCE(ph.phoebe_guides_read, 0) AS phoebe_guides_read,
  COALESCE(ph.phoebe_cards_compared, 0) AS phoebe_cards_compared,
  COALESCE(ph.phoebe_session_engagement_s, 0.0) AS phoebe_session_engagement_s,
  cr.target_revenue
FROM ${ref("click_revenue")} cr
LEFT JOIN ${ref("rolling_rpc")} rr USING (click_id)
LEFT JOIN ${ref("sa360_auctions")} a ON a.click_id = cr.click_id
-- Phoebe join: keyed on user_pseudo_id when the click stream carries it.
-- Falls through to NULL → defaults above when missing.
LEFT JOIN ${ref("phoebe_features")} ph
  ON ph.user_pseudo_id = cr.user_pseudo_id
