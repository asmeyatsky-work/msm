# Bounds calibration agent — Cloud Run service (ADR 0005 deploy). Separate from
# the deterministic Job image (Dockerfile); installs the agent extras and serves
# the FastAPI scheduler endpoint.
FROM python:3.12-slim
WORKDIR /app
COPY pyproject.toml ./
COPY src ./src
RUN pip install --no-cache-dir ".[agent]"
USER 1000:1000
ENV PORT=8080
CMD ["sh", "-c", "uvicorn msm_bounds.presentation.server:app --host 0.0.0.0 --port ${PORT:-8080}"]
